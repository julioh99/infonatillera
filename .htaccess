# Solo public/ es accesible por HTTP. Todo lo demas de la raiz se bloquea.
# Requiere AllowOverride (FileInfo AuthConfig Limit Options) y mod_rewrite.
# Solucion definitiva: apuntar el DocumentRoot a public/.
DirectoryIndex public/index.php index.php
Options -Indexes

# Defensa si mod_rewrite no estuviera disponible: bloquea por nombre de archivo
<FilesMatch "(^\.(?!well-known)|\.(sqlite|sqlite3|db|sql|md|lock|log|bak|ini|env)$|^(package|composer)(-lock)?\.json$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Dotfiles (.env, .git, .htaccess, ...) en cualquier nivel, salvo .well-known
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]

    # Directorios internos del proyecto
    RewriteRule ^(app|config|core|scripts|scratch|docs|export|storage|vendor|node_modules|logs)(/|$) - [F,L,NC]

    # Peticiones ya reescritas / directas a public/: dejar pasar (evita bucles)
    RewriteRule ^public(/|$) - [L]

    # Archivos sensibles por extension o nombre que no existan en public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} !-f
    RewriteRule (\.(sqlite|sqlite3|db|sql|md|json|lock|log|bak|ini|env|yml|yaml|dist)$|^(seed|info|resumen|task|promt)\.) - [F,L,NC]

    # Raiz / -> public/
    RewriteRule ^$ public/ [L]

    # Servir recursos estaticos de public/ si existen
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Todo lo demas -> public/index.php (sin comprobar la raiz: nunca se sirven archivos de la raiz)
    RewriteRule ^ public/index.php [QSA,L]
</IfModule>
