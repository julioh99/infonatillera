# Plantilla de variables de entorno - InfoNatillera
# Copia este archivo a .env y completa los valores. NUNCA subas .env a Git ni lo dejes accesible por web.
# Las variables reales del entorno (DB_DATABASE=... php ...) tienen prioridad sobre este archivo.

# ---- Base de datos (MySQL / MariaDB) ----
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=infonatillera
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_PREFIX=natillera_

# ---- Aplicacion ----
# 0 en produccion: el usuario ve mensajes genericos y el detalle va a logs/app.log.
# 1 solo en desarrollo: muestra tambien el detalle tecnico del error.
APP_DEBUG=0

# Migraciones: por defecto NO se aplican solas al abrir el sitio (se corre `php scripts/migrate.php` a mano).
# NT_AUTOMIGRATE=1 las aplica automaticamente en cada peticion (solo para pruebas locales).
NT_AUTOMIGRATE=0
# NT_NO_AUTOMIGRATE=1 apaga SIEMPRE las migraciones automaticas (recomendado en produccion). Con 0 las activa.
NT_NO_AUTOMIGRATE=1

# URL publica del sitio (sin barra final). Solo la usa scripts/verificar_despliegue.php para probar
# que /.env y /db.sql no se puedan descargar. Ejemplo: https://natillera.midominio.com
APP_URL=

# ---- BD remota usada por algunos scripts/ antiguos (no hace falta para operar el sistema) ----
REMOTE_DB_HOST=
REMOTE_DB_DATABASE=
REMOTE_DB_USERNAME=
REMOTE_DB_PASSWORD=

# ---- Web Push (VAPID). Generar con: php scripts/generate_vapid_keys.php ----
# Tienen prioridad sobre config/vapid_keys.php. No subir las reales al repositorio.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tudominio.com
